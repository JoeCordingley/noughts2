---

import Mustache from "mustache";
import fs from "fs";
import path from "path";
import "@styles/dynasty.css"

// load the template file as a string
const templatePath = path.resolve("../shared/templates/dynastyChoice.mustache");
const template = fs.readFileSync(templatePath, "utf-8");
const values = [ 
  {dynasty: "Archer", player: "Alice", taken : true, mine : false},
  {dynasty: "Bull", player: "Bob", taken : true, mine : false},
  {dynasty: "Pot", player: "Charlie", taken : true, mine : true},
  {dynasty: "Lion", taken : false, mine : false}
]
const rendered = Mustache.render(template, { values });
---

<div set:html={rendered}></div>
