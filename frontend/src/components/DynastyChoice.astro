---
const values = [ 
	{dynasty: "Archer", player: "Alice", taken : true, mine : false},
	{dynasty: "Bull", player: "Bob", taken : true, mine : false},
	{dynasty: "Pot", player: "Charlie", taken : true, mine : true},
	{dynasty: "Lion", taken : false, mine : false}
]
---
<style>
#board {
  max-width: 600px;
  margin: 0 auto;
}

.dynasty-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1em;
}

.dynasty-box {
  border: 1px solid #ccc;
  padding: 0.75em;
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  align-items: start;
}

button.dynasty {
  margin-top: 0.5em;
  padding: 0.4em 0.8em;
  background-color: green;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}
button.taken {
  background-color: gray;
}
button.mine {
  background-color: blue;
}
</style>

<div id="board">
	<h2>Choose Your Dynasty</h2>
	<div class="dynasty-grid">
		{values.map(({dynasty, taken, mine, player}) => (
			<div class="dynasty-box">
				<strong>{dynasty}</strong>
				<small>{taken ? `Player: ${player}` : "Available"}</small>
				{!taken && (
					<button class="dynasty">
						Choose
					</button>
				)}
			</div>
		))}
	</div>
</div>
