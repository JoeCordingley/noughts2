---
import Htmx from '@layouts/Htmx.astro';
export const prerender = false;
const { gameId } = Astro.params;
---
<style>
:global(#board) {
  max-width: 600px;
  margin: 0 auto;
}

:global(.dynasty-grid) {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1em;
}

:global(.dynasty-box) {
  border: 1px solid #ccc;
  padding: 0.75em;
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  align-items: start;
}

:global(button.dynasty) {
  margin-top: 0.5em;
  padding: 0.4em 0.8em;
  background-color: green;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}
:global(div.mine) {
  border: 2px solid blue;
}
</style>
<Htmx title="Tigers and Pots" >
    <h1>{gameId}</h1>
    <div id="game" hx-get=`/api/tigris/${gameId}` hx-trigger="load" />
</Htmx>
